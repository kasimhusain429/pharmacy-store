# Copy to .env.local (development) or set in your host's environment (production).

# Staff inbox at /staff. Use a long random value (at least 16 characters).
# Leave empty to switch the staff area off.
STAFF_ACCESS_KEY=

# Public address of the site, used for share images (e.g. https://www.example-pharmacy.com).
SITE_URL=

# Where orders, prescriptions and messages are stored. Defaults to ./.data
# Prescriptions are health data: use encrypted, backed-up storage in production.
DATA_DIR=
